# Copy these values into .env. Choose a local password; do not commit .env.
POSTGRES_DB=edu
POSTGRES_USER=postgres_edu
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# URL-encode reserved characters in the password here (for example, @ becomes %40).
DATABASE_URL=postgresql+psycopg://postgres_edu:change-me@localhost:5433/edu
